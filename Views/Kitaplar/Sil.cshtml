@model Kitap
@{
    ViewData["Title"] = "Kitap Sil";
}

<h1>Kitap Sil</h1>

<div class="alert alert-warning">
    <strong>@Model.Ad</strong> (@Model.Yazar)
    silinecek. Emin misiniz?
</div>

<form asp-action="Sil" method="post">
    <button type="submit" class="btn btn-danger">Evet, sil</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>
